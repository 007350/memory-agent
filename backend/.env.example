# Backend 环境变量模板，复制为 .env 并填入真实值

# LLM API (StepFun / OpenAI-compatible)
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL_MAIN=step-3.7-flash
LLM_MODEL_LIGHT=step-3.5-flash

# LightRAG Server
LIGHTRAG_BASE_URL=http://localhost:9621
LIGHTRAG_API_KEY=

# Memory DB (SQLite)
MEMORY_DB_PATH=memory.db

# Embedding (OpenAI-compatible API, 用于记忆语义检索; 留空则退化为关键词检索)
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096

# Memory Tuning
MEMORY_SEMANTIC_TOP_K=20
MEMORY_DECAY_HALF_LIFE_DAYS=14
MEMORY_CONTEXT_BUDGET_CHARS=3000
MEMORY_EVENT_SNIPPET_CHARS=200

# WebSearch API (Firecrawl)
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# Tool Use Configuration
PYTHON_REPL_TIMEOUT=5
PYTHON_REPL_MAX_OUTPUT=2000
